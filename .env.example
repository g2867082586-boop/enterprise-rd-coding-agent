# Defaults work without any model API key.
APP_ENV=development
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
ALLOW_MOCK_FALLBACK=true
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_MIN_SCORE=0.35
LEXICAL_MIN_SCORE=0.01
KNOWLEDGE_CORPUS=mock
ENTERPRISE_KNOWLEDGE_DIR=knowledge_base/enterprise
MOCK_KNOWLEDGE_DIR=knowledge_base/mock
KNOWLEDGE_CATALOG_PATH=knowledge_base/catalog/catalog.json

# Use sqlite for a key-free local demo; use mysql for the Docker service.
DATABASE_PROVIDER=sqlite
SQLITE_PATH=data/nebula_shop.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_DATABASE=nebula_shop
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
MYSQL_READONLY_USER=nebula_reader
MYSQL_READONLY_PASSWORD=
# Web authentication/chat writes use a separate least-privilege account.
MYSQL_APP_USER=nebula_app
MYSQL_APP_PASSWORD=
MYSQL_ORDER_USER=nebula_order
MYSQL_ORDER_PASSWORD=
DB_QUERY_TIMEOUT_SECONDS=5
DB_MAX_ROWS=100

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
REDIS_REQUIRED=false
JOB_QUEUE_NAME=enterprise-agent
JOB_INLINE_FALLBACK=true
ORDER_EVENT_POLL_SECONDS=2
UPLOAD_DIR=data/uploads
KNOWLEDGE_INDEX_VERSIONS_DIR=data/vector_store/versions
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=300
ALLOWED_ORIGINS=

BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1
SAMPLE_APP_URL=http://127.0.0.1:8000/

MCP_SERVER_COMMAND=
TRACE_DIR=data/traces
CHECKPOINT_PATH=data/checkpoints.sqlite
KNOWLEDGE_INDEX_PATH=data/vector_store/index.json
MAX_AGENT_ITERATIONS=8
MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_STEPS=6
AGENT_MAX_REPLANS=2
AGENT_REQUEST_TIMEOUT_SECONDS=180
APPROVAL_CHECKPOINT_PATH=data/approval-checkpoints.sqlite
DEV_REBUILD_TOKEN=

FRONTEND_URL=http://127.0.0.1:5173
PUBLIC_ORIGIN=http://127.0.0.1:8080
SESSION_COOKIE_NAME=nebula_session
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
CSRF_ENABLED=false
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=12
CHAT_MAX_CONCURRENT_PER_USER=1

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-rd-agent-v2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-rd-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
